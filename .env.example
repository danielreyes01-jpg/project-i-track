PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_long_random_secret
ADMIN_ACCESS_KEY=change_this_to_a_long_random_admin_key
ADMIN_EMAIL=admin@adm.local
ADMIN_PASSWORD=change_this_admin_password
ADMIN_FIRSTNAME=System
ADMIN_LASTNAME=Administrator

# Database options:
# DB_CLIENT=sqlite3 | mysql2 | pg
DB_CLIENT=sqlite3
# Used when DB_CLIENT=sqlite3
SQLITE_FILE=./data/app.db
# Used when DB_CLIENT=mysql2 or pg
DB_CONNECTION_STRING=

# Verification and resend controls (milliseconds)
# Email verification is currently disabled in favor of admin approval.
VERIFY_TOKEN_TTL_MS=1800000
RESEND_MIN_INTERVAL_MS=60000
RESEND_WINDOW_MS=900000
RESEND_MAX_PER_WINDOW=3

# Login lockout controls
MAX_LOGIN_FAILURES=5
LOCKOUT_DURATION_MS=900000

# SMTP provider mode: gmail or custom
SMTP_PROVIDER=gmail

# Gmail mode
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM="ADM Dashboard <your_gmail_address@gmail.com>"

# Custom SMTP mode (used when SMTP_PROVIDER=custom)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
